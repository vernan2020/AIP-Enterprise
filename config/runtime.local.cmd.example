@echo off
REM AIP Enterprise local runtime overrides.
REM Copy this file to config\runtime.local.cmd and set only values required
REM by the workstation. runtime.local.cmd is intentionally excluded from Git.

REM Financial Copilot / OpenAI Responses API. Disabled unless explicitly enabled.
REM set "AIP_LLM_ENABLED=true"
REM set "AIP_LLM_PROVIDER=openai"
REM set "OPENAI_API_KEY=YOUR_OPENAI_API_KEY"
REM set "AIP_LLM_MODEL=gpt-5.6"
REM set "AIP_LLM_TIMEOUT_SECONDS=45"
REM set "AIP_LLM_MAX_OUTPUT_TOKENS=1400"

REM BCCR live SDDE REST API. Current official base:
REM https://apim.bccr.fi.cr/SDDE/api/Bccr.GE.SDDE.Publico.Indicadores.API
REM A Bearer token generated in BCCR Indicadores Economicos -> Mi Perfil is required.
REM Leave the token unset only when a populated persisted local-history fallback exists.
REM set "AIP_BCCR_BASE_URL=https://apim.bccr.fi.cr"
REM set "AIP_BCCR_NAME=YOUR_REGISTERED_NAME"
REM set "AIP_BCCR_EMAIL=YOUR_REGISTERED_EMAIL"
REM set "AIP_BCCR_TOKEN=YOUR_BCCR_BEARER_TOKEN"

REM Optional explicit source overrides. Normally EnvironmentLoader resolves the
REM institutional Windows paths automatically.
REM set "AIP_PORTFOLIO_ROOT=C:\path\to\investment-root"
REM set "AIP_ICL_ROOT=C:\path\to\analysis-root"
REM set "AIP_VECTOR_PATH=C:\path\to\vector-root"
REM set "AIP_DATA_CUTOFF_DATE=2026-08-27"
