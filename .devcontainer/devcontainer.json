{
  "name": "AIP Enterprise",

  "postCreateCommand": "uv venv --python 3.13 --seed .venv && . .venv/bin/activate && python -m pip install -e '.[dev]'",

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ]
    }
  }
}